# ============================================================
# Tech Store — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# 🔐 API Backend (must use HTTPS in production)
# Development: http://localhost:3000/api/auth
# Production: https://api.yourdomain.com/auth
VITE_API_URL=http://localhost:3000/api/auth

# 📧 EmailJS Configuration (for Contact form)
# Get these from https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY

# 🛡 Security (do NOT set these in .env — use a secrets manager in production)
# VITE_CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'
